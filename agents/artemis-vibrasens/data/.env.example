# Clés d'Artémis Vibrasens. Jamais de vraie valeur dans le dépôt.
#
# Artémis Vibrasens a quatre profils : Hermes passe donc en mode multi-profils, et chaque profil
# ne voit que les clés de SON .env, jamais l'environnement du conteneur. Les clés vont
# donc dans le .env de chaque profil qui s'en sert, lisible par hermes seul :
# - /srv/hermes/clients/vibrasens/agents/artemis-vibrasens/data/.env : profil default (l'orchestrateur), Google Chat compris ;
# - /srv/hermes/clients/vibrasens/agents/artemis-vibrasens/data/profiles/<profil>/.env : collecteur, enrichisseur, qualificateur.
# « hermes-ctl sante » dit, profil par profil, les clés qui manquent (sans les valeurs).
# Après une modification : « hermes-ctl redemarrer artemis-vibrasens ».
# Ces fichiers se remplissent par ops/installer.sh (dépôt kalhyps/hermes-vibrasens).

# Google Chat, profil default seulement. Projet Google Cloud du Workspace de l'entreprise :
# messages reçus par un abonnement Pub/Sub en mode pull (aucun port ouvert sur le serveur),
# réponses par l'API Chat. Clé du compte de service dans
# /srv/hermes/clients/vibrasens/agents/artemis-vibrasens/data/google-chat/credentials.json (hermes seul, 600).
GOOGLE_CHAT_PROJECT_ID=
GOOGLE_CHAT_SUBSCRIPTION_NAME=projects/<projet>/subscriptions/<abonnement>
GOOGLE_CHAT_SERVICE_ACCOUNT_JSON=/opt/data/google-chat/credentials.json
# L'adresse du dirigeant seulement.
GOOGLE_CHAT_ALLOWED_USERS=
# Facultatif : espace où partent les messages des tâches planifiées (spaces/AAAA…).
GOOGLE_CHAT_HOME_CHANNEL=

# Routeur web (web_search, web_extract) : Exa et Parallel gratuits sans clé, puis
# TinyFish et Keenable (gratuits avec clé, conseillées), Perplexity rapide et
# Firecrawl en dernier recours (payants, 60 recherches et 25 pages par jour au plus).
# Comptes ouverts au nom de Vibrasens (demande de Nicolas le 24/10 : plus aucune clé de
# Nicolas), posés par « ops/installer.sh cle <NOM> » ; un service sans clé est sauté.
TINYFISH_API_KEY=
KEENABLE_API_KEY=
PERPLEXITY_API_KEY=
FIRECRAWL_API_KEY=

# Outils de collecte et d'enrichissement des agents (transmis par terminal.env_passthrough).
# Ce sont des crédits payants : dépensés seulement avec l'accord du dirigeant.
# Firecrawl pour les outils (Hermes ne transmet jamais FIRECRAWL_API_KEY aux commandes) :
LEADGEN_FIRECRAWL_API_KEY=
# Registre britannique, gratuit :
COMPANIES_HOUSE_API_KEY=
# Module LinkedIn (recherche publique de décideurs, puis emails des contacts validés) :
SERPER_API_KEY=
DROPCONTACT_API_KEY=
