#!/usr/bin/env python3
"""Keep dashboard auth out of commits. Live config.yaml on disk is left untouched."""
from __future__ import annotations

import re
import subprocess
import sys

BLOCKED_PATHS = {".env", "hermes.env"}
# Fichiers de clés du serveur (/srv/hermes/secrets/<agent>.env) et des homes des agents.
BLOCKED_BASENAMES = {
    "auth.json", "auth.yml", "hermes.env", ".env", "kalhyps.env", "leadgen.env",
    "artemis-vibrasens.env", "vibrasens.env",
}


def git(*args: str, input_text: str | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", *args],
        check=False,
        capture_output=True,
        text=True,
        input=input_text,
    )


def redact_dashboard_auth(text: str) -> str:
    lines = text.splitlines(keepends=True)
    out: list[str] = []
    in_basic_auth = False
    basic_indent: int | None = None
    skip_hash_value = False
    for line in lines:
        raw = line[:-1] if line.endswith("\n") else line
        newline = "\n" if line.endswith("\n") else ""
        stripped = raw.lstrip(" ")
        indent = len(raw) - len(stripped)
        if re.match(r"basic_auth:\s*$", stripped):
            in_basic_auth = True
            basic_indent = indent
            out.append(line)
            continue
        if (
            in_basic_auth
            and stripped
            and not stripped.startswith("#")
            and basic_indent is not None
            and indent <= basic_indent
        ):
            in_basic_auth = False
            skip_hash_value = False
        if skip_hash_value:
            skip_hash_value = False
            if stripped and not stripped.startswith("#"):
                continue
        if in_basic_auth and re.match(r"password_hash:\s*$", stripped):
            out.append(f'{" " * indent}password_hash: ""{newline}')
            skip_hash_value = True
            continue
        if in_basic_auth and re.match(r"password_hash:\s+\S", stripped):
            out.append(f'{" " * indent}password_hash: ""{newline}')
            continue
        if in_basic_auth and re.match(r"secret:\s*", stripped):
            out.append(f'{" " * indent}secret: ""{newline}')
            continue
        out.append(line)
    return "".join(out)


def staged_names() -> list[str]:
    proc = git("diff", "--cached", "--name-only", "-z")
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr)
        sys.exit(1)
    return [p for p in proc.stdout.split("\0") if p]


def restage_redacted(path: str, content: str) -> None:
    hashed = git("hash-object", "-w", "--stdin", input_text=content)
    if hashed.returncode != 0:
        sys.stderr.write(hashed.stderr)
        sys.exit(1)
    digest = hashed.stdout.strip()
    updated = git("update-index", "--cacheinfo", f"100644,{digest},{path}")
    if updated.returncode != 0:
        sys.stderr.write(updated.stderr)
        sys.exit(1)


def main() -> int:
    staged = staged_names()
    for path in staged:
        base = path.rsplit("/", 1)[-1]
        if path in BLOCKED_PATHS or base in BLOCKED_BASENAMES:
            sys.stderr.write(f"pre-commit: refusing to commit secret file {path}\n")
            return 1
        if not path.endswith("config.yaml"):
            continue
        shown = git("show", f":{path}")
        if shown.returncode != 0:
            continue
        redacted = redact_dashboard_auth(shown.stdout)
        if redacted != shown.stdout:
            restage_redacted(path, redacted)
            shown = git("show", f":{path}")
        if "scrypt" + "$" in shown.stdout:
            sys.stderr.write(
                f"pre-commit: {path} still looks like it contains a password hash\n"
            )
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
